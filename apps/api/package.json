{
  "name": "@budgeteer/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./contract": "./src/contract.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsx scripts/build.ts",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "seed": "tsx src/db/seed.ts",
    "seed:demo": "tsx src/db/seedDemo.ts",
    "db:reset": "tsx src/db/reset.ts",
    "db:restore": "tsx src/db/restore.ts",
    "db:fresh": "npm run db:reset && npm run seed",
    "create-admin": "tsx src/cli/create-admin.ts",
    "reset-password": "tsx src/cli/reset-password.ts",
    "disable-user": "tsx src/cli/disable-user.ts"
  },
  "dependencies": {
    "@budgeteer/domain": "*",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/static": "^10.1.2",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "kysely": "0.27.6",
    "pg": "^8.12.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.2",
    "@types/pg": "^8.11.0",
    "esbuild": "^0.21.5",
    "kysely-pglite": "^0.6.1",
    "tsx": "^4.16.0"
  }
}
