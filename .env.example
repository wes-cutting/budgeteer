# ============================================================================
# .env.example — copy to .env at the REPO ROOT (gitignored) and fill in values.
#
# This repo-root .env is AUTO-LOADED: the API loads it via dotenv (apps/api),
# the web app via Vite's envDir (apps/web) — one shared file for both. Real
# process env vars still take precedence over .env.
#
# Config comes from the ENVIRONMENT and is validated at STARTUP; the app fails
# loudly on missing/invalid config (docs/ARCHITECTURE.md §4, docs/SECURITY.md §1).
# NEVER commit real secrets — only this example file is tracked. Vite exposes
# ONLY VITE_-prefixed vars to the browser; everything else stays server-side.
# Stack: ADR-0001 (TS · React+Vite · Fastify) · ADR-0002 (PostgreSQL · Kysely).
# ============================================================================

# Runtime environment: development | test | production
APP_ENV=development

# --- API server (apps/api) ---
PORT=3001
LOG_LEVEL=info

# Interface the API listens on. Defaults to loopback (this machine only) — a dev box has no reason
# to serve the network. 0.0.0.0 (serve every device on your network) is now SAFE: authentication is
# default-deny at the resource level (BUD-E13 · ADR-0009), which was the documented precondition
# (docs/SECURITY.md §3). The production container sets it to 0.0.0.0.
# HOST=127.0.0.1

# Browser origins allowed to call the API (CORS), comma-separated. An ALLOWLIST, never `*`
# (docs/SECURITY.md §2). Defaults to the Vite dev origins; set explicitly per environment
# (e.g. your deployed web origin in production).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Secret that signs the session cookie (ADR-0009 · BUD-S87). REQUIRED in production (APP_ENV=production
# fails to start without it); dev/e2e fall back to a fixed non-secret. Use a long random value, e.g.
# `openssl rand -base64 48`. Min length 16. Never commit the real value.
# SESSION_SECRET=

# Whether the session cookie is marked `Secure` (sent over HTTPS only). Defaults to ON in production,
# OFF elsewhere. Browsers DISCARD a Secure cookie that arrives over plain HTTP, so a production
# deployment without TLS will appear to accept a login and then bounce straight back to the login
# page. Terminate TLS at a reverse proxy if you can; only set this to false on a LAN you trust, since
# the session token is then readable by anything on that network (the server warns at startup).
# SESSION_COOKIE_SECURE=true

# --- Datastore (per ADR-0002) ---
# In dev/test the API uses an in-process PGlite database (no server needed) when
# DATABASE_URL is unset. REQUIRED in production: PGlite is a dev dependency and is not shipped in the
# production image, so there is nothing to fall back to and startup fails loudly without this.
# DATABASE_URL=postgres://user:password@host:5432/budgeteer

# Optional: persist the dev PGlite store to a local directory so data survives server restarts
# and `npm run seed` (in apps/api) writes to the same store the server reads. Path is relative
# to apps/api when running npm scripts. The repo-root /data/ dir is already gitignored.
# Ignored when DATABASE_URL is set. Leave unset to keep the fast in-memory default for dev/test.
# PGLITE_DIR=../../data/budgeteer-dev

# Absolute path to the built web assets (apps/web/dist). SET → this process also serves the SPA,
# which is how the production container ships one image on one origin (ADR-0008 §1). Leave UNSET in
# dev, where Vite serves the web on :5173. Startup fails if the path holds no index.html.
# WEB_STATIC_ROOT=/app/apps/web/dist

# --- Web app (apps/web) ---
# The ORIGIN the browser uses to reach the API — no path. The client appends the `/api` namespace
# itself (the API lives under /api so it can't collide with the SPA's own routes: `/accounts` is a
# page, `/api/accounts` is the endpoint). Set this EMPTY for a same-origin deployment, as the
# container build does; leaving it unset falls back to the dev default below.
VITE_API_BASE_URL=http://localhost:3001
